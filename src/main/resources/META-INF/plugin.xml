<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.ttftcuts.gigatools</id>
    <name>GigaTools</name>
    <vendor>TTFTCUTS</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends>icu.windea.pls</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.github.ttftcuts.gigatools.startup.GigaToolsInit" />

        <annotator language="PARADOX_SCRIPT" implementationClass="com.github.ttftcuts.gigatools.annotation.DefinitionPropertyAnnotator"/>
        <completion.contributor language="PARADOX_SCRIPT" implementationClass="com.github.ttftcuts.gigatools.annotation.DefinitionPropertyCompletionContributor" />

        <notificationGroup displayType="BALLOON" id="GigaTools"/>

        <fileType
                name="GigaTools Tag"
                implementationClass="com.github.ttftcuts.gigatools.language.TagLangFileType"
                fieldName="INSTANCE"
                language="GigaTag"
                extensions="gigatag"
        />
        <lang.parserDefinition language="GigaTag" implementationClass="com.github.ttftcuts.gigatools.language.TagLangParserDefinition" />
        <multiHostInjector implementation="com.github.ttftcuts.gigatools.language.TagLangInjector" />
        <lang.syntaxHighlighterFactory language="GigaTag" implementationClass="com.github.ttftcuts.gigatools.language.TagLangSyntaxHighlighterFactory" />
    </extensions>

    <actions>

        <group id="gigas.group" text="GigaTools" popup="true">
            
            <action
                    id = "giga.regenlists"
                    class="com.github.ttftcuts.gigatools.actions.RegenMegaCategoryLists"
                    text = "Rebuild Kilo/Giga Category Triggers"
            />
            <action
                    id = "giga.regenecoloc"
                    class="com.github.ttftcuts.gigatools.actions.RegenJobEcoLoc"
                    text = "Rebuild Economic Modifier Localisation"
            />

            <separator/>

            <action
                    id = "giga.reloadtooldata"
                    class="com.github.ttftcuts.gigatools.actions.ReloadToolData"
                    text = "Reload Data File"
            />

            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>

    </actions>
</idea-plugin>
